# Copy to .env and fill in real values. Never commit .env.
PORT=5050
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maykraft?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list is allowed (e.g. production + preview URLs)
CLIENT_URL=http://localhost:5173
# Set to true to run on an in-memory MongoDB that is auto-seeded (no Mongo install needed)
USE_MEMORY_DB=false
# Set to false to serve only the API (e.g. when the frontend is on Vercel)
SERVE_CLIENT=true
